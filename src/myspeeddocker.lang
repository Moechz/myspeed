name         = "MySpeed"
auth         = "gnmyt"
version      = "@@VERSION@@"
descript     = "网络测速与历史记录面板，支持定时测速。"
release_note = "1. First release."
important    = "首次使用請開啟網頁完成初始化。資料保存在 DockerAppData/myspeeddocker，重新啟動和升級不會遺失。容器以 uid 1000 運行，掛載目錄需對該使用者可讀。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。解除安裝並刪除資料前請備份。區域網路內為 HTTP。"

